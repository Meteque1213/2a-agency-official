        <h1 class="article-heading">Coca-Cola Reports Fourth Quarter and Full Year 2025 Results</h1>
        <div class="related-documents-line hidden-print row justify-content-between align-items-center">  
            <time datetime="2026-02-10T06:55:00" class="date">
                February 10, 2026 6:55 am EST            </time>
