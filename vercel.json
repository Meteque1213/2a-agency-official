{
  "version": 2,
  "name": "2a-agency-official",
  "headers": [
    {
      "source": "/api/mcp",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-api-key, x-payment" }
      ]
    }
  ],
  "functions": {
    "api/mcp/index.ts": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "ai-integrity.json,node/**,api/node/**"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false
}