{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/mcp/index.ts": {
      "includeFiles": "node/**,api/node/**"
    }
  },
  "rewrites": [
    { "source": "/api/node/:path*", "destination": "/node/:path*" },
    { "source": "/api/mcp", "destination": "/api/mcp/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
