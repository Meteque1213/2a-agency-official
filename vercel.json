{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/mcp/index.ts": {
      "includeFiles": "ai-integrity.json,node/**,api/node/**"
    }
  },
  "headers": [
    {
      "source": "/api/mcp",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}