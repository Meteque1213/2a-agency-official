    "Airbus": "https://www.airbus.com/en/investors/financial-results-and-annual-reports"
}

def mass_financial_scan(mapping):
    print(f"🚀 [2A AGENCY] - STARTING MASS FINANCIAL AUDIT ON {len(mapping)} TARGETS\n")
    # User-agent pour éviter d'être bloqué immédiatement
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
    }
    
    final_updates = []

    for name, url in mapping.items():
        print(f"🔎 Probing {name}...")
        try:
            # On respire entre chaque requête (Politesse numérique)
            time.sleep(1.5) 
            
            response = requests.get(url, headers=headers, timeout=20)
            if response.status_code != 200:
                print(f"  🚨 {name}: HTTP Error {response.status_code}")
                final_updates.append({"name": name, "proof": None, "status": f"HTTP_{response.status_code}"})
                continue

            soup = BeautifulSoup(response.text, 'html.parser')
            links = soup.find_all('a', href=True)
            
            # Recherche du Graal (URD, Annual Report, 2024/2025)
            patterns = [r'2024', r'2025', r'URD', r'Universal', r'Registration', r'Annual', r'Rapport']
            
            found_url = None
            for link in links:
                href = link['href']
                text = link.get_text().strip()
                if href.lower().endswith('.pdf'):
                    if any(re.search(p, href, re.I) or re.search(p, text, re.I) for p in patterns):
                        found_url = urljoin(url, href)
                        break
            
            if found_url:
                print(f"  ✅ {name}: Document Found.")
                final_updates.append({"name": name, "proof": found_url, "status": "VERIFIED"})
            else:
                print(f"  ⚠️ {name}: No PDF detected (Review URL manually).")
                final_updates.append({"name": name, "proof": None, "status": "MANUAL_CHECK_REQ"})

        except Exception as e:
            print(f"  🚨 {name}: Scan Exception.")
            final_updates.append({"name": name, "proof": None, "status": "ERROR"})

    return final_updates

# Exécution du moteur
updates = mass_financial_scan(REGISTRY_MAPPING)

# Bilan final
print("\n" + "="*80)
print("💎 2A AGENCY - FINANCIAL REGISTRY UPDATE SUMMARY")
print("="*80)
for item in updates:
    proof_display = item['proof'] if item['proof'] else "N/A"
    print(f"{item['name'].ljust(20)} | {item['status'].ljust(15)} | {proof_display}")