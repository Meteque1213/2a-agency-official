    "Brunello Cucinelli": "https://investor.brunellocucinelli.com/en/financial-results/reports-presentations",
    "Burberry": "https://www.burberryplc.com/en/investors/results-reports.html",
    "Zegna": "https://www.zegnagroup.com/en/investors/financial-results/",
